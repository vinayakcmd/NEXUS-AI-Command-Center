# NEXUS Planetary Command Center - Environment Configuration

# Application Environment (production, development)
VITE_APP_ENV=production

# Custom Telemetry WebSocket or REST Endpoint (Leave empty for simulated telemetry mode)
VITE_TELEMETRY_API_URL=

# Optional LLM Inference Gateway URL (Leave empty to use built-in simulated copilot)
VITE_LLM_GATEWAY_URL=

# Default Telemetry Refresh Interval in seconds (default: 3)
VITE_DEFAULT_REFRESH_INTERVAL=3
